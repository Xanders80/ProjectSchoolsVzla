# Application Environment
APP_ENV=production
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false

# Database Configuration (MariaDB Externo)
DB_HOST=shared-mariadb
DB_PORT=3306
DB_DATABASE=dbSchollAdm
DB_USERNAME=shared_user
DB_PASSWORD=shared_password

# Spring Boot Actuator
ACTUATOR_ENABLED=true
DDL_AUTO=update