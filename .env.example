# Database Configuration
DB_URL=jdbc:mariadb://localhost:3306/dbSchollAdm
DB_USERNAME=root
DB_PASSWORD=your_secure_password_here

# Security Configuration
COOKIE_SECURE=true
SSL_ENABLED=true

# Application Configuration
SPRING_PROFILES_ACTIVE=prod
DDL_AUTO=validate
SHOW_SQL=false
THYMELEAF_CACHE=true

