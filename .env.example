# Application Environment
APP_ENV=production
DDL_AUTO=validate
SHOW_SQL=false

# Database Configuration (MariaDB)
DB_URL=jdbc:mariadb://localhost:3306/dbSchollAdm
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# Signature Secret (HMAC-SHA256 for document verification — min 32 chars)
SIGNATURE_SECRET=your-secret-key-min-32-chars

# Cookie Secure (true in production with HTTPS)
COOKIE_SECURE=true

# SSL (true in production)
SSL_ENABLED=true

# Email Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_mail_user
MAIL_PASSWORD=your_mail_password
MAIL_FROM=noreply@yourschool.com
MAIL_ENABLED=false

# Thymeleaf Cache (false for dev, true for prod)
THYMELEAF_CACHE=true

# Upload Limits
# MAX_FILE_SIZE=10MB

# Session Timeout
# SESSION_TIMEOUT=30m

# Business Logic
# APP_SCHOOL_NAME=Escuela
# APP_PROMOTION_AVERAGE_THRESHOLD=70.0
# APP_PROMOTION_MAX_FAILED_COURSES=2
# APP_ATTENDANCE_ALERT_THRESHOLD=5
# APP_HR_LATE_THRESHOLD=09:00

# Flyway
# FLYWAY_BASELINE_ON_MIGRATE=true
